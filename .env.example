# AnkiConnect (Anki must be running locally with the AnkiConnect add-on installed)
ANKICONNECT_URL=http://127.0.0.1:8765
ANKICONNECT_API_VERSION=6

# Anthropic API (Sonnet for production generation)
ANTHROPIC_API_KEY=

# YouTube Data API
YOUTUBE_API_KEY=

# Unsplash (image fallback tier)
UNSPLASH_ACCESS_KEY=

# ElevenLabs (optional TTS upgrade over gTTS)
ELEVENLABS_API_KEY=
