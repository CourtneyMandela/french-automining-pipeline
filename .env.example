# AnkiConnect (Anki must be running locally with the AnkiConnect add-on installed)
ANKICONNECT_URL=http://127.0.0.1:8765
ANKICONNECT_API_VERSION=6

# Anthropic API (Sonnet for production generation)
ANTHROPIC_API_KEY=

# LingQ API (read on LingQ -> looked-up words auto-sync).
# Get your key at https://www.lingq.com/accounts/apikey/
LINGQ_API_KEY=
LINGQ_LANGUAGE_CODE=fr

# YouTube Data API
YOUTUBE_API_KEY=

# Unsplash (image fallback tier)
UNSPLASH_ACCESS_KEY=

# ElevenLabs (TTS for WordAudio/ChunkAudio + SecondExampleAudio; optional --
# these fields stay blank without it). Get a key at https://elevenlabs.io/
ELEVENLABS_API_KEY=
# Optional: a specific ElevenLabs voice ID from your account (defaults to a
# premade multilingual voice that handles French).
ELEVENLABS_VOICE_ID=
